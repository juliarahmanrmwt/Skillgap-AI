      <th>Peningkatan Efisiensi</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Kecepatan Respon HMR Komponen</td>
      <td>~142 ms</td>
      <td><strong>3.8 ms</strong></td>
      <td>37x Lebih Cepat (&lt; 5ms)</td>
    </tr>
    <tr>
      <td>Waktu Kompilasi CSS Pertama (Cold)</td>
      <td>1.85 s</td>
